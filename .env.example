# Trading Bot Configuration
# Copy this to .env and fill in values. Never commit .env.

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./tradingbot.db
# DATABASE_URL=postgresql://user:pass@localhost/tradingbot

# Simulation settings -- keep enabled while validating integrations
SIMULATION_MODE=true
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.08

# Polymarket (optional; public Gamma market scanning needs no credentials)
POLYMARKET_ENABLED=false
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Email/Google Magic Link proxy wallets commonly use signature type 1; confirm your account's type before setting this.
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_CHAIN_ID=137

# Kalshi API (RSA key auth for weather markets)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=true
FRED_API_KEY=
BLS_API_KEY=

# Mapbox token for map visualization (optional - demo token works)
VITE_MAPBOX_TOKEN=

# API hardening (required for controls and event WebSocket)
ADMIN_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
