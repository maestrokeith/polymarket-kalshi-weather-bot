# Prediction-market research bot configuration
# Copy to .env locally. Never commit .env or paste secrets into chat.
# Blank optional credentials are intentionally safe; adding a key does not activate execution.

# Local database
DATABASE_URL=sqlite:///./tradingbot.db

# SAFETY: keep paper trading on. Live execution remains disabled.
SIMULATION_MODE=true
LIVE_TRADING_ENABLED=false
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.15
MIN_EDGE_THRESHOLD=0.02
MAX_TRADE_SIZE=75
DAILY_LOSS_LIMIT=300

# Polymarket CLOB (public market-data endpoints may work without credentials)
POLYMARKET_ENABLED=false
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY_PATH=
# Optional only if you understand the local secret-handling implications:
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=

# Kalshi: start with DEMO; this project configuration alone does not authenticate requests.
KALSHI_ENABLED=false
KALSHI_ENVIRONMENT=demo
KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Weather sources
WEATHER_ENABLED=true
OPEN_METEO_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Optional paid/registered providers; leave blank if unused.
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=
TOMORROW_IO_API_KEY=
NOAA_API_TOKEN=
WEATHER_SCAN_INTERVAL_SECONDS=300
WEATHER_SETTLEMENT_INTERVAL_SECONDS=1800
WEATHER_MIN_EDGE_THRESHOLD=0.08
WEATHER_MAX_ENTRY_PRICE=0.70
WEATHER_MAX_TRADE_SIZE=100
WEATHER_CITIES=nyc,chicago,miami,los_angeles,denver

# US economic indicators (optional; providers have their own terms and quotas)
FRED_API_KEY=
BLS_API_KEY=

# Crypto price sources: public Coinbase endpoints need no private account key.
BTC_PRICE_SOURCE=coinbase
COINBASE_API_BASE_URL=https://api.exchange.coinbase.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=

# Optional AI providers. Keys may incur charges; respect configured budget.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_LOG_ALL_CALLS=true
AI_DAILY_BUDGET_USD=1.0

# Frontend/public configuration only. Never put private API secrets in VITE_* values.
VITE_MAPBOX_TOKEN=
ADMIN_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
